--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6f75e3b4b165c241ae2aae4dd6e253a, type: 3}
  m_Name: VillageGathering
  m_EditorClassIdentifier: Assembly-CSharp::Lemko.VillageStoryDefinition
  storyId: village_gathering
  title: A gathering for the village
  introduction: Our neighbours are preparing a gathering. Help at any of the eight
    places.
  contributions:
  - activityId: Shop
    title: Gather supplies
    request: Collect supplies for the shared table.
    success: The supplies are ready.
    illustration: {fileID: 21300000, guid: 0409e1e4011fe3141adb43c0900c3554, type: 3}
  - activityId: FamilyTree
    title: Deliver invitations
    request: Invite the relatives shown in the family tree.
    success: The invitations are ready.
    illustration: {fileID: 21300000, guid: 0bf289acdaa19de4093502285cef0ef0, type: 3}
  - activityId: Farm
    title: Prepare the animals
    request: Help finish the animal pens before the gathering.
    success: The animal pens are ready.
    illustration: {fileID: 21300000, guid: de49af9641cc77b43a85e0b3f0ed903e, type: 3}
  - activityId: House
    title: Prepare the room
    request: Prepare furniture in the requested room.
    success: The room is ready.
    illustration: {fileID: 21300000, guid: a59575459d406a144a7b70794338b0a5, type: 3}
  - activityId: Memory
    title: Pack the checklist
    request: Match the packing checklist pictures and words.
    success: The packing checklist is ready.
    illustration: {fileID: 21300000, guid: 7b60beb34b641c1458a1262e0fe556c7, type: 3}
  - activityId: Numbers
    title: Prepare tickets
    request: Choose the requested numbers for the tickets.
    success: The tickets are ready.
    illustration: {fileID: 21300000, guid: 1ca5ff0453f14764d958adc0a18d319d, type: 3}
  - activityId: Alphabet
    title: Prepare the labels
    request: Check the spelling for our preparations.
    success: The spelling preparations are ready.
    illustration: {fileID: 0}
  - activityId: Weather
    title: Plan the weather
    request: Set the requested weather and temperature for our planned day.
    success: The weather plan is ready.
    illustration: {fileID: 21300000, guid: 3c4734eee3266494f8cb87af424925b8, type: 3}
